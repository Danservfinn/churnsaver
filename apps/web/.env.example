# Churn Saver Environment Variables
# Copy this file to .env.local and fill in your values

# Whop App Configuration (Required)
WHOP_API_KEY=
NEXT_PUBLIC_WHOP_APP_ID=
NEXT_PUBLIC_WHOP_AGENT_USER_ID=
NEXT_PUBLIC_WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=

# Database Configuration (Required)
DATABASE_URL=

# Application Configuration
ENABLE_PUSH=true
ENABLE_DM=true
DEFAULT_INCENTIVE_DAYS=3

# Error Tracking (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Monetization - Whop Product IDs for Subscription Tiers
# Create these products in your Whop Developer Dashboard
WHOP_PRODUCT_ID_FREE=
WHOP_PRODUCT_ID_PRO_MONTHLY=
WHOP_PRODUCT_ID_PRO_ANNUAL=
WHOP_PRODUCT_ID_MAX_MONTHLY=
WHOP_PRODUCT_ID_MAX_ANNUAL=

# Feature Flags
ENABLE_TIER_ENFORCEMENT=true
ENABLE_ANALYTICS=true
ENABLE_CUSTOM_TEMPLATES=true

# Analytics Configuration
ANALYTICS_RETENTION_DAYS=365

# Cron Authentication
CRON_SECRET=
