{
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "functions": {
    "src/app/api/cron/process-queue/route.ts": {
      "maxDuration": 15
    },
    "src/app/api/cron/reminders/route.ts": {
      "maxDuration": 15
    },
    "src/app/api/cron/maintenance/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/webhooks/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "x-vercel-sso-protection",
          "value": "none"
        }
      ]
    },
    {
      "source": "/api/cases/export",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "ALLOW_INSECURE_DEV": "false"
  },
  "crons": [
    { "path": "/api/cron/process-queue", "schedule": "0 0 * * *" },
    { "path": "/api/cron/maintenance", "schedule": "0 0 * * *" }
  ]
}